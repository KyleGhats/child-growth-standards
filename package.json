{
  "name": "child-growth-standards",
  "version": "0.3.0",
  "description": "Pediatric growth — NNC (eOPT) cutoff classification and WHO LMS z-scores with nutritional status",
  "type": "module",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleGhats/child-growth-standards.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.mjs",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "DATA_PROVENANCE.md"
  ],
  "scripts": {
    "sync:sources": "node scripts/sync-sources-from-bmrs.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:browser": "node scripts/generate-browser-registry.mjs && node scripts/build-browser.mjs",
    "build": "npm run build:data && tsc -p tsconfig.build.json && npm run build:browser",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "who",
    "nnc",
    "growth",
    "anthropometry",
    "z-score",
    "nutrition"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
